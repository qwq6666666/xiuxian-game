      "stageMin": 6,
      "lifespanLeftMax": 10,
      "reachedNot": ["zhuji:0"],
      "bottleneck": false,
      "ageMax": 150
    },
    "choices": [
      {
        "text": "不等了，強行衝關",
        "outcomes": [
          {
            "weight": 12,
            "weightPerAttribute": { "insight": 1 },
            "text": "經脈像被硬生生撐開的舊門，每一寸都在叫。我咬著牙不肯停，最後一口氣灌進去時，眼前的暗忽然亮了。門開了，我在門檻上跪了很久。",
            "effects": { "advanceRealm": true }
          },
          {
            "weight": 88,
            "text": "靈氣衝到半途便散了，我伏在地上，吐出一口血。不甘心像一根細針，扎在胸口，拔不出來。我只是笑了一聲，說這輩子總算沒有白等。",
            "effects": { "breakthroughFail": true }
          }
        ]
      },
      {
        "text": "放下，平靜終老",
        "outcomes": [
