[
  {
    "id": "youth_harvest_001",
    "type": "choice",
    "title": "秋收",
    "text": "秋收時節，鄰家缺人手，托我幫忙搶收。我的功課還沒做完。",
    "weight": 30,
    "tone": "neutral",
    "conditions": { "ageMin": 12, "ageMax": 24 },
    "choices": [
      {
        "text": "去幫忙",
        "outcomes": [
          {
            "weight": 60,
            "text": "我割了三天稻，腰痠得像是練過一套功法。鄰家給了兩袋米和一籃雞蛋。",
            "effects": { "spiritStones": 6 }
          },
          {
            "weight": 40,
            "text": "我割了三天稻，腰痠得直不起來，過幾日卻覺得筋骨比往常結實了些。鄰家給了兩袋米。",
            "effects": { "spiritStones": 6, "attributes": { "bone": 1 } }
          }
        ]
      },
      {
        "text": "回去修行",
        "outcomes": [
          {
            "weight": 100,
            "text": "我關起門吐納三日，鄰家的稻子是別人幫著割完的。他們嘴上沒說什麼。",
            "effects": { "cultivation": 0.05 }
          }
        ]
      }
    ]
  },
  {
    "id": "marriage_001",
    "type": "choice",
    "title": "媒人上門",
    "text": "媒人踏破了門檻，說{village}東頭有戶人家的姑娘，性子好，手也巧。",
    "weight": 14,
    "tone": "neutral",
    "conditions": { "ageMin": 24, "ageMax": 50, "flagsNot": ["marriage_done"] },
    "choices": [
      {
        "text": "見一面",
        "outcomes": [
          {
            "weight": 60,
            "text": "見面時茶涼了兩回，話沒說上幾句，卻也不覺得不自在。後來親事沒成，倒多了一個說話的人。",
            "effects": { "attributes": { "fortune": 1 }, "flags": ["marriage_done"] }
          },
          {
            "weight": 40,
            "text": "對方問我一年能賺多少靈石，我答不出來，這門親事便沒了下文。",
            "effects": { "flags": ["marriage_done"] }
          }
        ]
      },
      {
        "text": "婉言拒絕",
        "outcomes": [
          {
            "weight": 100,
            "text": "我說修行為重，媒人嘆著氣走了，下次來得好像更勤。",
            "effects": { "flags": ["marriage_done"] }
          }
        ]
      }
    ]
  },
  {
    "id": "debt_001",
    "type": "choice",
    "title": "親戚借貸",
    "text": "遠房親戚登門，說{village}今年收成不好，想向我借些靈石周轉，字據都帶來了。",
    "weight": 10,
    "tone": "neutral",
    "maxPerLife": 2,
    "conditions": { "ageMin": 26, "ageMax": 80 },
    "choices": [
      {
        "text": "借給他",
        "requires": { "spiritStones": 15 },
        "outcomes": [
          {
            "weight": 50,
            "text": "他年底如數歸還，另添了一籃自家種的菜。我吃了半個月。",
            "effects": { "spiritStones": 3 }
          },
          {
            "weight": 50,
            "text": "字據收進抽屜，很多年沒再拿出來看過。",
            "effects": { "spiritStones": -15 }
          }
        ]
      },
      {
        "text": "推說手頭緊",
        "outcomes": [
          {
            "weight": 100,
            "text": "我說修行人哪有積蓄。親戚信了一半，走時門關得有點重。",
            "effects": {}
          }
        ]
      }
    ]
  },
  {
    "id": "flood_001",
    "type": "choice",
    "highlight": 2,
    "title": "河水暴漲",
    "text": "連日大雨，{village}一帶河水暴漲，田舍被淹了一半，鄰里在屋頂上喊人。",
    "weight": 5,
    "tone": "bad",
    "conditions": { "ageMin": 20 },
    "choices": [
      {
        "text": "下水救人",
        "outcomes": [
          {
            "weight": 56,
            "weightPerAttribute": {"bone": 4},
            "text": "我在水裡來回十幾趟，救出好幾戶人家，自己也病了一場。事後村裡湊了些東西謝我。",
            "effects": { "lifespan": -2, "spiritStones": 12, "attributes": { "fortune": 1 } }
          },
          {
            "weight": 41,
            "text": "水勢太急，我救出兩人便被沖到下游，躺了很久才爬起來。",
            "effects": { "lifespan": -3 }
          },
          {
            "weight": 3,
            "text": "一個浪頭打來，我沒能再浮上來。",
            "effects": { "death": true }
          }
        ]
      },
      {
        "text": "在高處喊人來",
        "outcomes": [
          {
            "weight": 100,
            "text": "我在高處喊了半夜，嗓子啞了，人倒是都被找來了。",
            "effects": {}
          }
        ]
      },
      {
        "text": "守在家中打坐",
        "outcomes": [
          {
            "weight": 100,
            "text": "水退之後，我的屋子竟安然無恙。鄰里看我的目光有些複雜。",
            "effects": { "cultivation": 0.03 }
          }
        ]
      },
      {
        "text": "背著人涉水而出",
        "requires": {"attributes": {"bone": 7}},
        "outcomes": [
          {
            "weight": 70,
            "text": "我踩著水底的石頭，一趟背出一戶人家，竟不覺得累。事後有人往我屋裡送了些吃用。",
            "effects": {"spiritStones": 8, "attributes": {"bone": 1}}
          },
          {
            "weight": 30,
            "text": "我背出幾戶人家便力竭，在高處歇了半日。",
            "effects": {"lifespan": -1}
          }
        ]
      }
    ]
  },
  {
