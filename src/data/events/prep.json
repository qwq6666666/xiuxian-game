    "choices": [
      {
        "text": "不再算了，繼續閉關",
        "outcomes": [
          {
            "weight": 100,
            "text": "你把算稿燒了，換來一夜好眠。",
            "effects": {}
          }
        ]
      },
      {
        "text": "守在洞中，再把心境磨一磨",
        "outcomes": [
          {
            "weight": 100,
            "text": "你一遍遍回想從前失手的地方，像在翻一本寫得很糟的舊帳。看完後，心定了。",
            "effects": {
              "lifespan": -2,
              "attributes": {
                "insight": 1
              }
            }
          }
        ]
      },
      {
        "text": "尋人買一張避雷符",
        "requires": {
          "spiritStones": 300
        },
        "outcomes": [
          {
            "weight": 80,
            "text": "賣符的人報了價，你沒還價。這種時候還價，是對自己命的不敬。",
            "effects": {
              "spiritStones": -300,
              "items": {
                "bilei_fu": 1
              }
            }
          },
          {
            "weight": 20,
            "text": "符是真的，只是被人先用過一半。你這才想起，貨色不能只看價錢。",
            "effects": {
              "spiritStones": -300
            }
          }
        ]
      }
    ]
  },
  {
