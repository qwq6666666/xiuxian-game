            "effects": { "spiritStones": -8, "fragment": { "maxTier": 3 } }
          },
          {
            "weight": 55,
            "text": "拆開一看，全是作廢的當票。",
            "effects": { "spiritStones": -8 }
          }
        ]
      },
      {
        "text": "不看了",
        "outcomes": [
          {
            "weight": 100,
            "text": "我搖搖頭走開，攤主連頭都沒抬。",
            "effects": {}
          }
        ]
      }
    ]
  },
  {
