[
  {
    "id": "cave_001",
    "type": "choice",
    "highlight": 2,
    "title": "山中古洞",
    "text": "你在採藥途中發現一處被藤蔓遮蔽的洞口，洞內隱隱有靈氣流出。",
    "weight": 10,
    "tone": "good",
    "conditions": { "realmMin": "lianqi", "ageMin": 16, "flagsNot": ["cave_001_done"] },
    "choices": [
      {
        "text": "入洞一探",
        "outcomes": [
          {
            "weight": 60,
            "text": "石台上置一玉瓶，瓶身古篆斑駁。你屏息啟封，內有丹藥一顆，另附字條：「存放三百年，藥效自負。」",
            "effects": { "items": { "juqi_dan": 1 }, "flags": ["cave_001_done"] }
          },
          {
            "weight": 30,
            "text": "洞內空無一物，只餘蛛網與積塵。白走一趟，倒也落得清靜。",
            "effects": { "flags": ["cave_001_done"] }
          },
          {
            "weight": 10,
            "text": "洞中妖獸暴起，你重傷而逃。",
            "effects": { "lifespan": -5, "flags": ["cave_001_done"] }
          }
        ]
      },
      {
        "text": "記下位置，日後再來",
        "outcomes": [
          {
            "weight": 100,
            "text": "你在洞外的山石上刻下記號。",
            "effects": { "flags": ["cave_001_marked"] }
          }
        ]
      }
    ]
  },
  {
    "id": "cave_002",
    "type": "choice",
    "highlight": 4,
    "title": "重返古洞",
    "text": "你循著記號重返古洞。這一次，洞深處有微光閃動，似是一處久封的洞府。",
    "weight": 15,
    "tone": "good",
    "conditions": { "realmMin": "lianqi", "flags": ["cave_001_marked"] },
    "choices": [
      {
        "text": "深入洞府",
        "outcomes": [
          {
            "weight": 50,
            "text": "石室之中，前人留有一卷殘篇與幾枚靈石。你參悟數日，修為大進。",
            "effects": { "cultivation": 0.35, "spiritStones": 40 }
          },
          {
            "weight": 20,
            "text": "石室禁制猶在，靈光一閃，你被震出洞外，修為受損。",
            "effects": { "cultivation": -0.15 }
          },
          {
            "weight": 10,
            "text": "石壁暗格之中，靜靜躺著一枚丹藥，靈氣內斂，色澤溫潤。",
            "effects": { "items": { "zhuji_dan": 1 } }
          },
          {
            "weight": 20,
            "text": "石室中空空如也，唯壁上刻著一行小字：「道在腳下。」你默然良久，退出洞外。",
            "effects": { "attributes": { "mind": 1 } }
          }
        ]
      },
      {
        "text": "封洞離去",
        "outcomes": [
          {
            "weight": 100,
            "text": "你將洞口重新掩好，轉身離去。此洞留給後來人罷。",
            "effects": { "attributes": { "fortune": 1 } }
          }
        ]
      }
    ]
  },
  {
    "id": "senior_001",
    "type": "choice",
    "highlight": 2,
    "title": "路遇老者",
    "text": "山道旁，一位白髮老者拄杖而立，自稱乾糧遺失，想向你討口吃食。",
    "weight": 8,
    "tone": "good",
    "conditions": { "ageMin": 14 },
    "choices": [
      {
        "text": "分他乾糧",
        "outcomes": [
          {
            "weight": 100,
            "text": "老者接過乾糧，連聲道謝，臨走前多看了你兩眼。",
            "effects": { "flags": ["senior_helped"] }
          }
        ]
      },
      {
        "text": "贈他靈石",
        "requires": { "spiritStones": 10 },
        "outcomes": [
          {
            "weight": 100,
            "text": "老者推辭再三，終究收下。他望著你，目光裡有幾分你看不懂的東西。",
            "effects": { "spiritStones": -10, "attributes": { "fortune": 1 }, "flags": ["senior_helped"] }
          }
        ]
      },
      {
        "text": "視而不見",
        "outcomes": [
          {
            "weight": 100,
            "text": "你繞道而行，身後傳來幾聲輕嘆，大約是風。",
            "effects": {}
          }
        ]
      }
    ]
  },
  {
    "id": "senior_002",
    "type": "choice",
    "highlight": 4,
    "title": "老者回贈",
    "text": "多年之後，你在市集上遇見當年那位老者。他衣衫依舊樸素，氣度卻已大不相同。",
    "weight": 15,
    "tone": "good",
    "conditions": { "ageMin": 20, "flags": ["senior_helped"] },
    "choices": [
      {
        "text": "上前行禮",
        "outcomes": [
          {
            "weight": 55,
            "text": "老者含笑點頭，指點了你幾句吐納之法。你依言而行，只覺氣機通暢許多。",
            "effects": { "cultivation": 0.3, "attributes": { "insight": 1 } }
          },
          {
            "weight": 30,
            "text": "老者從袖中取出幾枚丹藥，道是當年一飯之謝。",
            "effects": { "items": { "juqi_dan": 2 } }
