          {
            "weight": 15,
            "text": "老者贈你一枚金紋丹藥，道是延年之物，請你珍重。",
            "effects": { "items": { "yanshou_dan": 1 } }
          }
        ]
      },
      {
        "text": "裝作未見",
        "outcomes": [
          {
            "weight": 100,
            "text": "你低頭疾行，與老者擦肩而過。背後無人喚你。",
            "effects": {}
          }
        ]
      }
    ]
  },
  {
    "id": "market_001",
    "type": "choice",
    "title": "坊市異販",
    "text": "坊市角落，一名攤主壓低聲音，說他手中有一枚祖傳的玉符，只賣有緣人。",
